GROQ_API_KEY=your_groq_api_key

# Production: restrict CORS (comma-separated origins, e.g. https://regtranslate.vercel.app,https://yourapp.com)
# CORS_ORIGINS=*
GOOGLE_API_KEY=your_gemini_key_as_backup
CHROMA_PERSIST_DIR=./chroma_db
# When REGTRANSLATE_REQUIRE_AUTH=1 (default), regulation RAG data lives under ./user_data/<hash>/chroma_db per GitHub user.
# REGTRANSLATE_REQUIRE_AUTH=0 uses a single __local__ tenant (CI/tests; legacy layout at repo root).
# REGTRANSLATE_USER_DATA_ROOT=./user_data
# Compliance scanner code embeddings (default: sibling chroma_scanner_code/). Separate from CHROMA_PERSIST_DIR avoids schema conflicts.
# CHROMA_CODE_PERSIST_DIR=./chroma_scanner_code
GROQ_MODEL=llama-3.3-70b-versatile

# Audit (§ 2.2.2): tamper-evident logs, 6-year retention
AUDIT_LOG_DIR=./audit_logs
AUDIT_RETENTION_YEARS=6

# Jira (optional; can also be entered in UI)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_atlassian_api_token

# Role → assignee (accountId for JIRA Cloud). Auto-assign tasks by responsible_role.
JIRA_ASSIGNEE_BACKEND_ENGINEER=557058:xxx-xxx-xxx
JIRA_ASSIGNEE_FRONTEND_ENGINEER=557058:yyy-yyy-yyy
JIRA_ASSIGNEE_DEVOPS=557058:zzz-zzz-zzz
JIRA_ASSIGNEE_SECURITY=557058:aaa-aaa-aaa

# Sprint field (default customfield_10020 for JIRA Cloud)
# JIRA_SPRINT_FIELD_ID=customfield_10020

# GitHub (optional; for prepopulating export UI)
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=your_github_personal_access_token

# GitHub OAuth for RegTranslate (PDF app + Compliance Scanner): https://github.com/settings/developers
# OAuth runs as a separate service (default port 9020). Register this callback URL on the GitHub OAuth app:
#   http://127.0.0.1:9020/auth/github/callback
# With Vite, the UI calls /oauth → 9020 so cookies stay on the same origin as /api. Override if your OAuth host differs:
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:9020/auth/github/callback
# COMPLIANCE_SCANNER_SESSION_SECRET=long-random-string
# COMPLIANCE_SCANNER_AUTH_DB=  # optional override path for SQLite auth sessions (default: scan_history/auth.sqlite)
# COMPLIANCE_SCANNER_CORS_ORIGINS=http://127.0.0.1:5173,https://your-app.example
